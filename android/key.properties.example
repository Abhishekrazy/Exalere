# Android Release Signing Configuration Example
# Copy this file to `android/key.properties` for local signing, or provide
# the corresponding GitHub Actions secrets for automated CI/CD signing:
# - ANDROID_KEYSTORE_BASE64
# - ANDROID_KEYSTORE_PASSWORD
# - ANDROID_KEY_ALIAS
# - ANDROID_KEY_PASSWORD

storePassword=your_keystore_password
keyPassword=your_key_password
keyAlias=your_key_alias
storeFile=upload-keystore.jks
