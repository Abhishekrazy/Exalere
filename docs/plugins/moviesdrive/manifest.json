{
  "id": "moviesdrive",
  "name": "MoviesDrive",
  "version": "1.0.0",
  "description": "Native in-app scraper for MoviesDrive. Searches its JSON index and resolves HubCloud, PixelDrain and CDN sources.",
  "icon": "https://abhishekrazy.github.io/Exalere/plugins/moviesdrive/icon.png",
  "resources": [
    "stream",
    "meta"
  ],
  "types": [
    "movie",
    "series"
  ],
  "idPrefixes": [
    "tt",
    "moviesdrive"
  ],
  "behaviorHints": {
    "configurable": false,
    "configurationRequired": false
  }
}
